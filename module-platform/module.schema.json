{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DevelopmentTools module",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "hostVersion", "RevitVersion", "assembly", "entryClass", "ToolId", "Ribbon", "permissions", "dependencies", "tests"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "hostVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "RevitVersion": {"type": "array", "items": {"enum": ["2024", "2025", "2026"]}, "minItems": 1, "uniqueItems": true},
    "assembly": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*\\.dll$"},
    "entryClass": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$"},
    "ToolId": {"type": "string", "pattern": "^DT_[A-Za-z][A-Za-z0-9_]*$"},
    "Ribbon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "text", "category"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"},
        "text": {"type": "string", "minLength": 1},
        "category": {"enum": ["drawing", "model", "review"]},
        "icon": {"type": "string", "minLength": 1, "maxLength": 8},
        "color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
        "tools": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "text", "entryClass"],
            "properties": {
              "name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"},
              "text": {"type": "string", "minLength": 1},
              "entryClass": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$"},
              "tooltip": {"type": "string", "minLength": 1},
              "icon": {"type": "string", "minLength": 1, "maxLength": 8},
              "color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"}
            }
          }
        }
      }
    },
    "permissions": {"type": "array", "items": {"enum": ["ribbon-command", "bridge-read"]}, "uniqueItems": true},
    "dependencies": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"}, "uniqueItems": true},
    "tests": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}
  }
}
