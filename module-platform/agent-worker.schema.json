{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BEAI hot-swappable agent worker",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "hostVersion", "revitVersions", "executable", "toolId", "displayName", "description", "permissions", "timeoutSeconds", "tests"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "hostVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "revitVersions": {"type": "array", "items": {"enum": ["2024", "2025", "2026"]}, "minItems": 1, "uniqueItems": true},
    "executable": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*\\.exe$"},
    "toolId": {"type": "string", "pattern": "^DT_[A-Za-z][A-Za-z0-9_]*$"},
    "displayName": {"type": "string", "minLength": 1, "maxLength": 80},
    "description": {"type": "string", "minLength": 1, "maxLength": 500},
    "permissions": {"type": "array", "items": {"enum": ["document-context-read"]}, "minItems": 1, "uniqueItems": true},
    "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 120},
    "tests": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}
  }
}
