<Project Sdk="Microsoft.NET.Sdk">
  <!-- 釋疑擷取與簡報模組。共用設定（net48、C# 7.3、Revit 2024 API）在 ..\Directory.Build.props。 -->
  <PropertyGroup>
    <AssemblyName>RfiDeckAgent</AssemblyName>
    <RootNamespace>RfiDeckAgent</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup>
    <!-- JavaScriptSerializer：設定檔與收件匣 item.json -->
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
  <ItemGroup>
    <!-- Python 程式（查圖、產生簡報、問題庫）全部內嵌在 DLL：模組更新＝程式更新，新同事不必另外拿 AI AGENT 資料夾。
         執行時由 src/ScriptStore.cs 寫到 <RTS 資料位置>\DT_AIAgent\py\ -->
    <EmbeddedResource Include="py\*.py" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
