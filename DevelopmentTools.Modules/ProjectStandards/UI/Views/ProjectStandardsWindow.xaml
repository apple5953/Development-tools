<Window x:Class="DevelopmentTools.ProjectStandards.UI.Views.ProjectStandardsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Multi-RVT 專案標準同步調和管理器 (Autodesk Revit 2024)" 
        Height="860" Width="1280" WindowStartupLocation="CenterScreen"
        Background="#F8FAFC" FontFamily="Microsoft JhengHei, Segoe UI">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0F172A" CornerRadius="6" Padding="16,10" Margin="0,0,0,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🏗 MULTI-RVT 專案標準同步調和管理器" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Border Background="#2563EB" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                        <TextBlock Text="Revit 2024" Foreground="White" FontSize="10" FontWeight="Bold"/>
                    </Border>
                    <Border Background="#059669" CornerRadius="4" Padding="6,2" Margin="6,0,0,0">
                        <TextBlock Text="零重啟熱載入版" Foreground="White" FontSize="10" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="Project Harmonization Engine" Foreground="#94A3B8" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Model Selection Bar -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Master Model Card -->
            <Border Grid.Column="0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,6,0">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="基準模型 (MASTER / BASELINE)" FontWeight="Bold" Foreground="#0F172A" FontSize="12"/>
                        <Border Background="#E0F2FE" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding MasterModel.SourceIcon}" Foreground="#0369A1" FontWeight="Bold" FontSize="11"/>
                        </Border>
                    </DockPanel>
                    <TextBlock Text="{Binding MasterModel.Name, FallbackValue='尚未選擇基準模型'}" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,4,0,2"/>
                    <TextBlock Text="{Binding MasterModel.SourceDescription}" Foreground="#64748B" FontSize="11"/>
                    <TextBlock Text="{Binding MasterModel.Status}" Foreground="#059669" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Target Model Card -->
            <Border Grid.Column="1" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12" Margin="6,0,0,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <TextBlock Text="比對與同步目標模型 (TARGET MODELS)" FontWeight="Bold" Foreground="#0F172A" FontSize="12" VerticalAlignment="Center"/>
                        <Button Content="+ 新增目標 RVT 檔案" Command="{Binding AddTargetFileCommand}" Padding="10,3" FontSize="11" Background="#E2E8F0" FontWeight="SemiBold" BorderThickness="0" HorizontalAlignment="Right" Cursor="Hand"/>
                    </DockPanel>
                    <ListBox ItemsSource="{Binding TargetModels}" MaxHeight="60" BorderThickness="0" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                    <Border Background="#EEF2FF" CornerRadius="4" Padding="4,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SourceIcon}" Foreground="#4F46E5" FontSize="10" FontWeight="SemiBold"/>
                                    </Border>
                                    <TextBlock Text="{Binding Status}" Foreground="#64748B" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Main Standards Matrix & Diff View (Full Height) -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Standards Category Matrix -->
            <Border Grid.Column="0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,6,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="2,0,2,8">
                        <TextBlock Text="📊 標準比對矩陣 (STANDARDS MATRIX)" FontWeight="Bold" FontSize="12" Foreground="#1E293B" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="✓ 全選" Command="{Binding SelectAllCategoriesCommand}" Padding="6,2" FontSize="10" Margin="0,0,4,0" Background="#F1F5F9" BorderThickness="1" BorderBrush="#CBD5E1" Cursor="Hand"/>
                            <Button Content="✕ 全不選" Command="{Binding UnselectAllCategoriesCommand}" Padding="6,2" FontSize="10" Background="#F1F5F9" BorderThickness="1" BorderBrush="#CBD5E1" Cursor="Hand"/>
                        </StackPanel>
                    </DockPanel>

                    <DataGrid ItemsSource="{Binding CategorySummaries}" SelectedItem="{Binding SelectedCategory}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single" BorderThickness="0" RowHeight="28" CanUserSortColumns="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="勾選" Width="38">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="標準類別" Binding="{Binding CategoryDisplayName}" Width="*"/>
                            <DataGridTextColumn Header="相同" Binding="{Binding EqualCount}" Width="45"/>
                            <DataGridTextColumn Header="差異⚠" Binding="{Binding ModifiedCount}" Width="50"/>
                            <DataGridTextColumn Header="缺漏✕" Binding="{Binding MissingCount}" Width="50"/>
                            <DataGridTextColumn Header="衝突🚫" Binding="{Binding ConflictCount}" Width="50"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Right: Field-Level Detailed Diff View -->
            <Border Grid.Column="1" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10" Margin="6,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1.5*"/>
                    </Grid.RowDefinitions>

                    <!-- Top: Items in Selected Category -->
                    <DockPanel Grid.Row="0">
                        <DockPanel DockPanel.Dock="Top" Margin="2,0,2,6">
                            <TextBlock Text="📑 該類別細項比對清單 (CATEGORY ITEMS)" FontWeight="Bold" FontSize="12" Foreground="#1E293B" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="✓ 全選此類別" Command="{Binding SelectAllItemsCommand}" Padding="8,2" FontSize="10" Margin="0,0,4,0" Background="#F1F5F9" BorderThickness="1" BorderBrush="#CBD5E1" Cursor="Hand"/>
                                <Button Content="✕ 全不選" Command="{Binding UnselectAllItemsCommand}" Padding="8,2" FontSize="10" Margin="0,0,4,0" Background="#F1F5F9" BorderThickness="1" BorderBrush="#CBD5E1" Cursor="Hand"/>
                                <Button Content="⚠ 僅勾選差異項" Command="{Binding SelectDiffOnlyItemsCommand}" Padding="8,2" FontSize="10" Background="#FEF3C7" BorderThickness="1" BorderBrush="#FCD34D" FontWeight="SemiBold" Cursor="Hand"/>
                            </StackPanel>
                        </DockPanel>

                        <DataGrid ItemsSource="{Binding CurrentDiffItems}" SelectedItem="{Binding SelectedDiffItem}" AutoGenerateColumns="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single" BorderThickness="0" RowHeight="28" CanUserSortColumns="True">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="{Binding RowBackground}"/>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="同步" Width="40">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelectedForSync, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="項目名稱" Binding="{Binding ItemDisplayName}" Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="比對狀態" Binding="{Binding StatusText}" Width="105" IsReadOnly="True"/>
                                <DataGridTextColumn Header="風險等級" Binding="{Binding RiskText}" Width="75" IsReadOnly="True"/>
                                <DataGridTextColumn Header="建議動作" Binding="{Binding ActionText}" Width="100" IsReadOnly="True"/>
                                <DataGridTextColumn Header="審閱 / 執行狀態" Binding="{Binding ConfirmationState}" Width="145" FontWeight="SemiBold" IsReadOnly="True"/>
                                <DataGridTextColumn Header="執行訊息" Binding="{Binding SyncMessage}" Width="150" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" Background="#E2E8F0" Margin="0,4" Cursor="SizeNS"/>

                    <!-- Bottom: Property-Level Diffs -->
                    <DockPanel Grid.Row="2">
                        <TextBlock Text="🔍 屬性層級詳細差異 (FIELD-LEVEL PROPERTY COMPARISON)" FontWeight="Bold" FontSize="11" Foreground="#475569" DockPanel.Dock="Top" Margin="4,0,4,4"/>
                        <DataGrid ItemsSource="{Binding CurrentFieldDiffs}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="24">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="屬性名稱" Binding="{Binding FieldName}" Width="180"/>
                                <DataGridTextColumn Header="基準值 (Master)" Binding="{Binding MasterValue}" Width="*"/>
                                <DataGridTextColumn Header="目標值 (Target)" Binding="{Binding TargetValue}" Width="*"/>
                                <DataGridTextColumn Header="狀態" Binding="{Binding StatusText}" Width="80"/>
                                <DataGridTextColumn Header="說明 / 衝突原因" Binding="{Binding Description}" Width="180"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer / Action Bar -->
        <Border Grid.Row="3" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12,10">
            <DockPanel>
                <StackPanel VerticalAlignment="Center" Margin="4,0,16,0">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#1E293B" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding DryRunSummary}" Foreground="#64748B" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="🔍 重新掃描比對 (Scan)" Command="{Binding ScanAndCompareCommand}" Background="#0284C7" Foreground="White" FontWeight="Bold" FontSize="12" Padding="16,8" Margin="0,0,8,0" BorderThickness="0" Cursor="Hand"/>
                    <Button Content="⚙ 步驟一：執行 Dry Run 模擬 (標記待確認)" Command="{Binding DryRunCommand}" Background="#334155" Foreground="White" FontWeight="Bold" FontSize="12" Padding="16,8" Margin="0,0,8,0" BorderThickness="0" Cursor="Hand"/>
                    <Button Content="✓ 步驟二：確認並執行同步 (Apply Sync)" Command="{Binding ApplySyncCommand}" Background="#16A34A" Foreground="White" FontWeight="Bold" FontSize="12" Padding="18,8" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
