<Window x:Class="OpeningDetailAddin.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:OpeningDetailAddin.Models"
        mc:Ignorable="d"
        Title="百葉開口元件剖面、索引與3D視圖自動生成器 (Revit 2024)" 
        Height="890" Width="760" 
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="#F4F6F9"
        FontFamily="Segoe UI, Microsoft JhengHei">
    
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderBrush" Value="#D0D7DE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1F2328"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#24292F"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="#D0D7DE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="#D0D7DE"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#0969DA"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0854B0"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#8C959F"/>
                    <Setter Property="Cursor" Value="No"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 頂部資訊看板 -->
        <Border Grid.Row="0" Background="#FFFFFF" Padding="14" CornerRadius="8" Margin="0,0,0,10" BorderBrush="#D0D7DE" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="🏢 牆開孔元件剖面、索引與3D視圖生成器" FontSize="16" FontWeight="Bold" Foreground="#0969DA"/>
                <TextBlock Text="支援「選取方塊 3D 視圖」加入圖紙、視埠樣式切換、精準視圖範圍裁切（保證塞入A3）與視圖樣板套用" 
                           FontSize="12" Foreground="#656D76" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- 主要設定與樹狀統計清單 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 1. 圖框與視埠設定 -->
                <GroupBox Header="1. 圖框選擇與視埠設定 (雙層圖框 + 視埠樣式與排版)">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 下拉選單 1: 圖框族群 -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="1. 選擇圖框族群：" Margin="0,0,0,8"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" 
                                  ItemsSource="{Binding TitleBlockFamilyNames}" 
                                  SelectedItem="{Binding SelectedTitleBlockFamily}"
                                  Margin="0,0,0,8"/>

                        <!-- 下拉選單 2: 圖框類型 (A3等規格) -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="2. 選擇圖框類型 (A3)：" Margin="0,0,0,8"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" 
                                  ItemsSource="{Binding FilteredTitleBlockTypes}" 
                                  SelectedItem="{Binding SelectedTitleBlock}"
                                  DisplayMemberPath="TypeName"
                                  Margin="0,0,0,8"/>

                        <!-- 下拉選單 3: 視埠標題樣式調整 -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="3. 調整視埠樣式 (標題)：" Margin="0,0,0,8"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" 
                                  ItemsSource="{Binding ViewportTypes}" 
                                  SelectedItem="{Binding SelectedViewportType}"
                                  DisplayMemberPath="Name"
                                  Margin="0,0,0,8"/>

                        <!-- 下拉選單 4: 圖紙視埠排版模式 -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="4. 圖紙視埠排版模式：" Margin="0,0,0,8"/>
                        <ComboBox Grid.Row="3" Grid.Column="1" 
                                  ItemsSource="{Binding LayoutModes}" 
                                  SelectedItem="{Binding SelectedLayoutMode}"
                                  Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="5. 圖紙編號前綴："/>
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding SheetNumberPrefix, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                </GroupBox>

                <!-- 2. 視圖範圍裁剪與樣板設定 -->
                <GroupBox Header="2. 視圖範圍裁剪與樣板設定 (剖面、索引、3D視圖樣板與裁切控制)">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 平面索引圖裁剪模式下拉選單 -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="平面索引圖裁剪控制：" Margin="0,0,0,8"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" 
                                  ItemsSource="{Binding CropModes}" 
                                  SelectedItem="{Binding SelectedCropMode}"
                                  Margin="0,0,0,8"/>

                        <!-- 剖面視圖樣板下拉選單 -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="剖面圖視圖樣板：" Margin="0,0,0,8"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" 
                                  ItemsSource="{Binding SectionViewTemplates}" 
                                  SelectedItem="{Binding SelectedSectionViewTemplate}"
                                  DisplayMemberPath="Name"
                                  Margin="0,0,0,8"/>

                        <!-- 索引視圖樣板下拉選單 -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="索引圖視圖樣板：" Margin="0,0,0,8"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" 
                                  ItemsSource="{Binding PlanViewTemplates}" 
                                  SelectedItem="{Binding SelectedPlanViewTemplate}"
                                  DisplayMemberPath="Name"
                                  Margin="0,0,0,8"/>

                        <!-- 3D視圖樣板下拉選單 -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="3D視圖樣板：" Margin="0,0,0,8"/>
                        <ComboBox Grid.Row="3" Grid.Column="1" 
                                  ItemsSource="{Binding View3DViewTemplates}" 
                                  SelectedItem="{Binding SelectedView3DViewTemplate}"
                                  DisplayMemberPath="Name"
                                  Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="牆剖面圖比例 (1:X)：" Margin="0,0,0,8"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding SectionScale}" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="樓層索引圖比例 (1:X)：" Margin="0,0,0,8"/>
                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding KeyPlanScale}" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="3D選取方塊視圖比例："/>
                        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding View3DScale}"/>
                    </Grid>
                </GroupBox>

                <!-- 3. 開口元件篩選條件 -->
                <GroupBox Header="3. 開口元件篩選條件">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="開口族群名稱：" Margin="0,0,0,8"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" 
                                  ItemsSource="{Binding AvailableFamilyNames}" 
                                  SelectedItem="{Binding SelectedFamilyName}"
                                  Margin="0,0,8,8"/>

                        <Button Grid.Row="0" Grid.Column="2" 
                                Content="🔄 重新掃描" 
                                Command="{Binding RefreshScanCommand}" 
                                Background="#57606A" 
                                Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="開口類型名稱："/>
                        <ComboBox Grid.Row="1" Grid.Column="1" 
                                  ItemsSource="{Binding AvailableTypeNames}" 
                                  SelectedItem="{Binding SelectedTypeName}"
                                  Margin="0,0,8,0"/>
                    </Grid>
                </GroupBox>

                <!-- 4. 各樓層開孔分佈統計與出圖勾選 -->
                <GroupBox Header="4. 各樓層開孔分佈統計與出圖勾選 (可依樓層獨立勾選檢查)">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Button Content="☑️ 全部勾選" Command="{Binding SelectAllCommand}" 
                                        Background="#2EA44F" Padding="8,4" FontSize="12" Margin="0,0,6,0"/>
                                <Button Content="⬜ 全部取消" Command="{Binding DeselectAllCommand}" 
                                        Background="#6E7781" Padding="8,4" FontSize="12" Margin="0,0,6,0"/>
                                <Button Content="🎯 僅勾選未建圖說" Command="{Binding SelectUnprocessedCommand}" 
                                        Background="#0969DA" Padding="8,4" FontSize="12" Margin="0,0,12,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <CheckBox Content="若元件已有對應視圖或圖紙則不重複建立 (略過已建項目)" 
                                          IsChecked="{Binding SkipExisting}" 
                                          FontWeight="SemiBold"
                                          Foreground="#1A7F37"
                                          VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <TreeView ItemsSource="{Binding LevelGroups}" Height="160" BorderBrush="#D0D7DE" BorderThickness="1" Background="#FAFAFA">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Walls}">
                                    <StackPanel Orientation="Horizontal" Margin="2">
                                        <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="🏢 " VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" Foreground="#0969DA" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    
                                    <HierarchicalDataTemplate.ItemTemplate>
                                        <HierarchicalDataTemplate ItemsSource="{Binding Openings}">
                                            <StackPanel Orientation="Horizontal" Margin="2">
                                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="🧱 " VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="#1F2328" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <HierarchicalDataTemplate.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="4,2">
                                                        <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBlock Text="🔲 " VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding DisplayName}" Foreground="#57606A" VerticalAlignment="Center"/>
                                                        <TextBlock Text=" - 規格: " Foreground="#8C959F" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding WidthMm, StringFormat={}{0:F0}}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        <TextBlock Text="×" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding HeightMm, StringFormat={}{0:F0}}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        <TextBlock Text=" mm (台度 FL+" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding SillHeightMm, StringFormat={}{0:F0}}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="mm)" VerticalAlignment="Center"/>
                                                        <Border Visibility="{Binding HasExistingStatusVisibility}" 
                                                                Background="#DDF4FF" BorderBrush="#54AEFF" BorderThickness="1" 
                                                                CornerRadius="3" Margin="8,0,0,0" Padding="4,1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding ExistingStatusBadge}" Foreground="#0969DA" FontSize="11" FontWeight="SemiBold"/>
                                                        </Border>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </HierarchicalDataTemplate.ItemTemplate>
                                        </HierarchicalDataTemplate>
                                    </HierarchicalDataTemplate.ItemTemplate>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部執行與狀態列 -->
        <Border Grid.Row="2" Padding="0,10,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{Binding StatusMessage}" Foreground="#0969DA" FontWeight="SemiBold" Margin="0,0,0,8" TextTrimming="CharacterEllipsis"/>

                <Button Grid.Row="1" 
                        Content="🚀 建立所選開孔圖紙 (含剖面詳圖 + 平面索引 + 3D選取方塊視圖)" 
                        Command="{Binding GenerateCommand}" 
                        Height="44" 
                        FontSize="14"/>
            </Grid>
        </Border>
    </Grid>
</Window>
