<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ======================================================== -->
    <!-- 1. COLOR DEFINITIONS                                     -->
    <!-- ======================================================== -->
    <Color x:Key="AppBackground">#F3F5F8</Color>
    <Color x:Key="SurfaceBackground">#FFFFFF</Color>
    <Color x:Key="SurfaceSubtle">#F8F9FB</Color>
    <Color x:Key="SurfaceCardHover">#EDF2F7</Color>
    <Color x:Key="SurfaceSelected">#EBF3FC</Color>

    <Color x:Key="BorderLight">#E2E8F0</Color>
    <Color x:Key="BorderDefault">#CBD5E1</Color>
    <Color x:Key="BorderDark">#94A3B8</Color>

    <Color x:Key="TextPrimary">#0F172A</Color>
    <Color x:Key="TextSecondary">#475569</Color>
    <Color x:Key="TextMuted">#94A3B8</Color>
    <Color x:Key="TextOnPrimary">#FFFFFF</Color>

    <Color x:Key="PrimaryAccent">#0263E0</Color>
    <Color x:Key="PrimaryAccentHover">#0252BA</Color>
    <Color x:Key="PrimaryAccentPressed">#014299</Color>
    <Color x:Key="PrimarySubtle">#E8F2FD</Color>

    <Color x:Key="StatusSuccess">#107C41</Color>
    <Color x:Key="StatusSuccessBg">#DFF6DD</Color>
    <Color x:Key="StatusSuccessBorder">#9ED89D</Color>

    <Color x:Key="StatusWarning">#C45100</Color>
    <Color x:Key="StatusWarningBg">#FFF1DB</Color>
    <Color x:Key="StatusWarningBorder">#FBD09F</Color>

    <Color x:Key="StatusError">#C42B1C</Color>
    <Color x:Key="StatusErrorBg">#FDE7E9</Color>
    <Color x:Key="StatusErrorBorder">#F4A8AC</Color>

    <Color x:Key="StatusInactive">#64748B</Color>
    <Color x:Key="StatusInactiveBg">#F1F5F9</Color>
    <Color x:Key="StatusInactiveBorder">#CBD5E1</Color>

    <Color x:Key="StatusCompleted">#0263E0</Color>
    <Color x:Key="StatusCompletedBg">#E8F2FD</Color>
    <Color x:Key="StatusCompletedBorder">#B8D9F9</Color>

    <!-- ======================================================== -->
    <!-- 2. SOLID COLOR BRUSHES                                   -->
    <!-- ======================================================== -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F5F8"/>
    <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="#F8F9FB"/>
    <SolidColorBrush x:Key="SurfaceCardHoverBrush" Color="#EDF2F7"/>
    <SolidColorBrush x:Key="SurfaceSelectedBrush" Color="#EBF3FC"/>

    <SolidColorBrush x:Key="BorderLightBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="BorderDefaultBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="BorderDarkBrush" Color="#94A3B8"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#475569"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="PrimaryAccentBrush" Color="#0263E0"/>
    <SolidColorBrush x:Key="PrimaryAccentHoverBrush" Color="#0252BA"/>
    <SolidColorBrush x:Key="PrimaryAccentPressedBrush" Color="#014299"/>
    <SolidColorBrush x:Key="PrimarySubtleBrush" Color="#E8F2FD"/>

    <SolidColorBrush x:Key="StatusSuccessBrush" Color="#107C41"/>
    <SolidColorBrush x:Key="StatusSuccessBgBrush" Color="#DFF6DD"/>
    <SolidColorBrush x:Key="StatusSuccessBorderBrush" Color="#9ED89D"/>

    <SolidColorBrush x:Key="StatusWarningBrush" Color="#C45100"/>
    <SolidColorBrush x:Key="StatusWarningBgBrush" Color="#FFF1DB"/>
    <SolidColorBrush x:Key="StatusWarningBorderBrush" Color="#FBD09F"/>

    <SolidColorBrush x:Key="StatusErrorBrush" Color="#C42B1C"/>
    <SolidColorBrush x:Key="StatusErrorBgBrush" Color="#FDE7E9"/>
    <SolidColorBrush x:Key="StatusErrorBorderBrush" Color="#F4A8AC"/>

    <SolidColorBrush x:Key="StatusInactiveBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="StatusInactiveBgBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="StatusInactiveBorderBrush" Color="#CBD5E1"/>

    <SolidColorBrush x:Key="StatusCompletedBrush" Color="#0263E0"/>
    <SolidColorBrush x:Key="StatusCompletedBgBrush" Color="#E8F2FD"/>
    <SolidColorBrush x:Key="StatusCompletedBorderBrush" Color="#B8D9F9"/>

    <!-- ======================================================== -->
    <!-- 3. FONTS & DIMENSIONS                                    -->
    <!-- ======================================================== -->
    <FontFamily x:Key="AppFontFamily">"Microsoft JhengHei UI", "Segoe UI", "PingFang TC", sans-serif</FontFamily>
    <FontFamily x:Key="CodeFontFamily">"Cascadia Code", "Consolas", monospace</FontFamily>

    <sys:Double x:Key="FontSizeCaption">11</sys:Double>
    <sys:Double x:Key="FontSizeBody">13</sys:Double>
    <sys:Double x:Key="FontSizeSubhead">15</sys:Double>
    <sys:Double x:Key="FontSizeTitle">18</sys:Double>
    <sys:Double x:Key="FontSizeHeadline">22</sys:Double>
    <sys:Double x:Key="FontSizeHero">28</sys:Double>

    <FontWeight x:Key="FontWeightNormal">Normal</FontWeight>
    <FontWeight x:Key="FontWeightMedium">SemiBold</FontWeight>
    <FontWeight x:Key="FontWeightBold">Bold</FontWeight>

    <sys:Double x:Key="Spacing4">4</sys:Double>
    <sys:Double x:Key="Spacing8">8</sys:Double>
    <sys:Double x:Key="Spacing12">12</sys:Double>
    <sys:Double x:Key="Spacing16">16</sys:Double>
    <sys:Double x:Key="Spacing24">24</sys:Double>
    <sys:Double x:Key="Spacing32">32</sys:Double>

    <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">8</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">12</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>

