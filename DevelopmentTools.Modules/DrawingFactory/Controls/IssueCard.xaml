<UserControl x:Class="BIMDrawingFactory.UI.Controls.IssueCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:controls="clr-namespace:BIMDrawingFactory.UI.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="650">
    <Border Style="{StaticResource StandardCardStyle}"
            BorderBrush="{StaticResource StatusWarningBorderBrush}"
            Background="{StaticResource SurfaceBackgroundBrush}"
            Margin="0,0,0,12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <controls:StatusBadge x:Name="SeverityBadge"
                                      Status="Warning"
                                      CustomText="需要確認"
                                      VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtFloorName" Text="7F" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="  •  " Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock x:Name="TxtSheetName" Text="A棟7FL結構開口圖" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>
            </Grid>

            <!-- User Message & Suggested Action -->
            <StackPanel Grid.Row="1" Margin="0,12,0,0">
                <TextBlock x:Name="TxtUserMessage"
                           Text="找不到完全吻合的視圖範圍框。"
                           FontSize="{StaticResource FontSizeSubhead}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                
                <TextBlock x:Name="TxtSuggestedAction"
                           Text="系統已找到相似範圍框『A棟7FL建築』(相似度 92%)，可直接採用。"
                           FontSize="{StaticResource FontSizeBody}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Resolution Action Box -->
            <Border Grid.Row="2"
                    Background="{StaticResource SurfaceSubtleBrush}"
                    CornerRadius="{StaticResource RadiusSmall}"
                    Padding="12,8"
                    Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Text="修復方案："
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>

                    <ComboBox x:Name="CmbResolutions"
                              Grid.Column="1"
                              MinHeight="32"
                              VerticalContentAlignment="Center"
                              SelectionChanged="OnResolutionSelectionChanged"/>
                </Grid>
            </Border>

            <!-- Technical Details Expander -->
            <Expander Grid.Row="3"
                      Header="顯示技術資訊 (Technical Details)"
                      Foreground="{StaticResource TextMutedBrush}"
                      FontSize="{StaticResource FontSizeCaption}"
                      Margin="0,8,0,0">
                <Border Background="{StaticResource SurfaceSubtleBrush}"
                        Padding="8"
                        Margin="0,4,0,0"
                        CornerRadius="4">
                    <TextBlock x:Name="TxtTechnicalDetails"
                               FontFamily="{StaticResource CodeFontFamily}"
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </Border>
            </Expander>
        </Grid>
    </Border>
</UserControl>
