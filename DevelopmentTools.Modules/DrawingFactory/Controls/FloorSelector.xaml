<UserControl x:Class="BIMDrawingFactory.UI.Controls.FloorSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="180" d:DesignWidth="500">
    <ItemsControl x:Name="FloorItemsControl">
        <!--
            Give every generated item its own fixed layout slot.  Relying only on
            the Button.Width inside a DataTemplate allowed WPF to briefly reuse a
            zero/partial-width ContentPresenter while CurrentFloors was refreshed;
            that was why an individual floor (most visibly 2F) could appear as a
            narrow empty strip even though the FloorChipDto still existed.
        -->
        <ItemsControl.ItemContainerStyle>
            <Style TargetType="{x:Type ContentPresenter}">
                <Setter Property="Width" Value="88"/>
                <Setter Property="MinWidth" Value="88"/>
                <Setter Property="Height" Value="78"/>
                <Setter Property="MinHeight" Value="78"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
            </Style>
        </ItemsControl.ItemContainerStyle>
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Button Margin="0,0,10,10"
                        Width="78" MinWidth="78"
                        Height="68" MinHeight="68"
                        Padding="0"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Cursor="Hand"
                        Click="OnFloorChipClicked">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"/>
                        </ControlTemplate>
                    </Button.Template>
                    <Border x:Name="ChipBorder"
                            Width="78" MinWidth="78"
                            Height="68" MinHeight="68"
                            CornerRadius="{StaticResource RadiusMedium}"
                            BorderThickness="1.5"
                            Background="{StaticResource SurfaceBackgroundBrush}"
                            BorderBrush="{StaticResource BorderLightBrush}"
                            Padding="6,8">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="TxtFloorName"
                                       Text="{Binding FloorName}"
                                       FontSize="{StaticResource FontSizeTitle}"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            
                            <TextBlock x:Name="TxtStatus"
                                       Text="{Binding StatusText}"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       HorizontalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Button>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=IsMouseOver}" Value="True">
                        <Setter TargetName="ChipBorder" Property="BorderBrush" Value="{StaticResource PrimaryAccentBrush}"/>
                        <Setter TargetName="ChipBorder" Property="Background" Value="#F1F5F9"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter TargetName="ChipBorder" Property="Background" Value="{StaticResource PrimaryAccentBrush}"/>
                        <Setter TargetName="ChipBorder" Property="BorderBrush" Value="#1D4ED8"/>
                        <Setter TargetName="TxtFloorName" Property="Foreground" Value="White"/>
                        <Setter TargetName="TxtStatus" Property="Foreground" Value="#E0E7FF"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
