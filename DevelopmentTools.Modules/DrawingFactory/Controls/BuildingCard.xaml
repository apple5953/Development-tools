<UserControl x:Class="BIMDrawingFactory.UI.Controls.BuildingCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="120" d:DesignWidth="220">
    <Button Background="Transparent"
            BorderThickness="0"
            Padding="0"
            Cursor="Hand"
            Click="OnCardClicked">
        <Button.Template>
            <ControlTemplate TargetType="{x:Type Button}">
                <Border x:Name="CardBorder"
                        Background="{StaticResource SurfaceBackgroundBrush}"
                        BorderBrush="{StaticResource BorderLightBrush}"
                        BorderThickness="1.5"
                        CornerRadius="{StaticResource RadiusLarge}"
                        Padding="16"
                        MinHeight="105"
                        MinWidth="200">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Top Title & Icon -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Text="{Binding BuildingData.Name, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                       FontSize="{StaticResource FontSizeTitle}"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>

                            <Path Grid.Column="1"
                                  Data="{StaticResource IconBuilding}"
                                  Fill="{StaticResource TextMutedBrush}"
                                  Width="18" Height="18"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Subtitle / Completed Info -->
                        <TextBlock Grid.Row="1"
                                   Text="{Binding BuildingData.Description, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                   FontSize="{StaticResource FontSizeBody}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,8,0,0"/>

                        <!-- Completion Progress Bar -->
                        <ProgressBar Grid.Row="2"
                                     Height="6"
                                     Margin="0,8,0,0"
                                     Value="{Binding BuildingData.CompletionPercentage, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                     Maximum="100"
                                     Background="{StaticResource SurfaceSubtleBrush}"
                                     Foreground="{StaticResource PrimaryAccentBrush}"
                                     BorderThickness="0"/>
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="CardBorder" Property="Background" Value="{StaticResource SurfaceCardHoverBrush}"/>
                        <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource PrimaryAccentBrush}"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Button.Template>
    </Button>
</UserControl>
