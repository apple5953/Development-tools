<Window x:Class="BIMDrawingFactory.UI.Views.MainShellView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:BIMDrawingFactory.UI.ViewModels"
        xmlns:views="clr-namespace:BIMDrawingFactory.UI.Views"
        xmlns:controls="clr-namespace:BIMDrawingFactory.UI.Controls"
        xmlns:models="clr-namespace:BIMDrawingFactory.UI.Models"
        mc:Ignorable="d"
        Title="BIM Drawing Factory"
        Height="780" Width="1180"
        MinHeight="680" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F8">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/BIMDrawingFactory.UI;component/Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type vm:QuickGenerateViewModel}">
                <views:QuickGenerateView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PreflightViewModel}">
                <views:PreflightView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PreviewViewModel}">
                <views:PreviewView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:GenerationResultViewModel}">
                <views:GenerationResultView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DrawingProgressViewModel}">
                <views:DrawingProgressView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DrawingRulesViewModel}">
                <views:DrawingRulesView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:MappingViewModel}">
                <views:MappingView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:StandardDrawingViewModel}">
                <views:StandardDrawingView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
                <views:HistoryView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SetupWizardViewModel}">
                <views:SetupWizardView/>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top Bar -->
            <RowDefinition Height="52"/>
            <!-- Main Content Area -->
            <RowDefinition Height="*"/>
            <!-- Bottom Status Bar -->
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBackgroundBrush}"
                BorderBrush="{StaticResource BorderLightBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Product Logo & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource PrimaryAccentBrush}" CornerRadius="6" Width="28" Height="28" Margin="0,0,10,0">
                        <Path Data="{StaticResource IconQuick}" Fill="White" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="BIM Drawing Factory"
                               FontSize="{StaticResource FontSizeTitle}"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Project & Document Metadata -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                    <TextBlock Text="專案：" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding ProjectName}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,16,0"/>

                    <TextBlock Text="標準圖組：" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <Border Background="{StaticResource PrimarySubtleBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,16,0">
                        <TextBlock Text="{Binding StandardGroup}" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" FontSize="{StaticResource FontSizeCaption}"/>
                    </Border>

                    <controls:StatusBadge Status="Success" CustomText="專案設定正常"/>
                </StackPanel>

                <!-- Top Right Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding ReloadCommand}"
                            Padding="8,6"
                            ToolTip="重新載入專案標準與模型特徵"
                            Margin="0,0,6,0">
                        <Path Data="{StaticResource IconRefresh}" Fill="{StaticResource TextSecondaryBrush}" Width="16" Height="16" Stretch="Uniform"/>
                    </Button>

                    <Button Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding StartWizardCommand}"
                            Padding="8,6"
                            ToolTip="啟動專案設定精靈"
                            Margin="0,0,6,0">
                        <Path Data="{StaticResource IconSettings}" Fill="{StaticResource TextSecondaryBrush}" Width="16" Height="16" Stretch="Uniform"/>
                    </Button>

                    <Button Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding HelpCommand}"
                            Padding="8,6"
                            ToolTip="使用說明">
                        <Path Data="{StaticResource IconHelp}" Fill="{StaticResource TextSecondaryBrush}" Width="16" Height="16" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN BODY: Left Nav + Workspace -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left Navigation Bar -->
                <ColumnDefinition Width="210"/>
                <!-- Central Workspace -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT NAVIGATION -->
            <Border Grid.Column="0"
                    Background="{StaticResource SurfaceBackgroundBrush}"
                    BorderBrush="{StaticResource BorderLightBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="12,16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Daily Operations Header -->
                        <TextBlock Text="日常作業"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="8,0,0,8"/>

                        <!-- Nav 1: Quick Generate -->
                        <Button Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="{x:Static models:NavigationPageKey.QuickGenerate}"
                                HorizontalContentAlignment="Left"
                                Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal" Margin="6,4">
                                <Path Data="{StaticResource IconQuick}"
                                      Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Fill" Value="{StaticResource TextSecondaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsQuickGenerateSelected}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource PrimaryAccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <TextBlock Text="快速建圖" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Normal"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsQuickGenerateSelected}" Value="True">
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>

                        <!-- Nav 2: Drawing Progress -->
                        <Button Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="{x:Static models:NavigationPageKey.DrawingProgress}"
                                HorizontalContentAlignment="Left"
                                Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal" Margin="6,4">
                                <Path Data="{StaticResource IconProgress}" Fill="{StaticResource TextSecondaryBrush}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="圖紙進度" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Separator Background="{StaticResource BorderLightBrush}" Margin="4,0,4,16"/>

                        <!-- Standard & Profile Management Header -->
                        <TextBlock Text="專案標準設定"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="8,0,0,8"/>

                        <!-- Nav 3: Standard Drawing -->
                        <Button Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="{x:Static models:NavigationPageKey.StandardDrawing}"
                                HorizontalContentAlignment="Left"
                                Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal" Margin="6,4">
                                <Path Data="{StaticResource IconSheet}" Fill="{StaticResource TextSecondaryBrush}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="標準圖說" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Nav 4: Drawing Rules -->
                        <Button Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="{x:Static models:NavigationPageKey.DrawingRules}"
                                HorizontalContentAlignment="Left"
                                Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal" Margin="6,4">
                                <Path Data="{StaticResource IconRules}" Fill="{StaticResource TextSecondaryBrush}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="圖說規則" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Nav 5: Mapping -->
                        <Button Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="{x:Static models:NavigationPageKey.Mapping}"
                                HorizontalContentAlignment="Left"
                                Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal" Margin="6,4">
                                <Path Data="{StaticResource IconMapping}" Fill="{StaticResource TextSecondaryBrush}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="對應設定" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Nav 6: History -->
                        <Button Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="{x:Static models:NavigationPageKey.History}"
                                HorizontalContentAlignment="Left"
                                Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal" Margin="6,4">
                                <Path Data="{StaticResource IconHistory}" Fill="{StaticResource TextSecondaryBrush}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="執行紀錄" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Nav 7: Settings -->
                        <Button Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="{x:Static models:NavigationPageKey.Settings}"
                                HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal" Margin="6,4">
                                <Path Data="{StaticResource IconSettings}" Fill="{StaticResource TextSecondaryBrush}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="偏好設定" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- CENTRAL WORKSPACE -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentPageViewModel}"/>
        </Grid>

        <!-- BOTTOM STATUS BAR -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceSubtleBrush}"
                BorderBrush="{StaticResource BorderLightBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource StatusSuccessBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="BIM Drawing Factory v2.0 (Revit 2024)" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- FLOATING TOAST NOTIFICATION OVERLAY -->
        <controls:ToastNotification Grid.Row="1"
                                    Message="{Binding ToastMessage}"
                                    Status="{Binding ToastStatus}"
                                    Visibility="{Binding IsToastVisible, Converter={x:Static controls:VisibilityConverters.BoolToVisibilityConverter}}"/>
    </Grid>
</Window>
