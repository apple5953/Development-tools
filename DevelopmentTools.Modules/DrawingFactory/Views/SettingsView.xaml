<UserControl x:Class="BIMDrawingFactory.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="偏好與進階設定 (Preferences)"
                       FontSize="{StaticResource FontSizeHeadline}"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="管理使用者偏好設定、預設圖框以及安全終止原則。"
                       FontSize="{StaticResource FontSizeBody}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource StandardCardStyle}" Padding="24">
            <StackPanel>
                <CheckBox Content="啟用自動儲存使用者介面偏好設定 (包含視窗大小、最後選擇棟別與篩選條件)"
                          IsChecked="{Binding AutoSavePreference}"
                          FontWeight="SemiBold"
                          Margin="0,0,0,16"/>

                <CheckBox Content="啟用批次出圖安全取消機制 (在完成目前圖紙後安全停止交易，避免 Revit 資料損壞)"
                          IsChecked="{Binding EnableSafeCancellation}"
                          FontWeight="SemiBold"
                          Margin="0,0,0,20"/>

                <!-- TitleBlock Auto-Detection Card -->
                <Border Background="{StaticResource SurfaceSelectedBrush}"
                        BorderBrush="{StaticResource PrimaryAccentBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMedium}"
                        Padding="16"
                        Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="圖框配置策略 (TitleBlock Strategy)"
                                   FontWeight="Bold"
                                   FontSize="{StaticResource FontSizeBody}"
                                   Foreground="{StaticResource PrimaryAccentBrush}"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="● 自動偵測模式 (預設推薦)：建立新圖紙時，系統將自動提取基準圖紙（如 SB1 系列）所使用的圖框族群與類型並自動放置，確保全案圖框完全一致，無需手動挑選。"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"/>
                        <Border Background="{StaticResource PrimarySubtleBrush}" CornerRadius="4" Padding="10,6">
                            <TextBlock Text="目前偵測之基準圖框：自動比照現有基準圖紙 (Auto-Detect Active TitleBlock)"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryAccentBrush}"
                                       FontSize="{StaticResource FontSizeCaption}"/>
                        </Border>
                    </StackPanel>
                </Border>

                <Button Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding SaveSettingsCommand}"
                        Content="儲存偏好設定"
                        HorizontalAlignment="Left"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
