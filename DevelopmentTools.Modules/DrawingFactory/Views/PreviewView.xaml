<UserControl x:Class="BIMDrawingFactory.UI.Views.PreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:controls="clr-namespace:BIMDrawingFactory.UI.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100">
    <Grid>
        <!-- Main Layout Grid -->
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="建立預覽 (Generation Preview)"
                           FontSize="{StaticResource FontSizeHeadline}"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="以基準圖紙為單位，核對其中每個視圖／明細表的目標名稱、樣板、樓層、範圍框與放置位置。"
                           FontSize="{StaticResource FontSizeBody}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Search & Batch Operation Bar -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search Box -->
                <TextBox Grid.Column="0"
                         Text="{Binding FilterKeyword, UpdateSourceTrigger=PropertyChanged}"
                         Padding="28,6,10,6"
                         VerticalContentAlignment="Center"/>

                <!-- Search Icon overlay inside text box -->
                <Path Data="{StaticResource IconSearch}"
                      Fill="{StaticResource TextMutedBrush}"
                      Width="14" Height="14"
                      Stretch="Uniform"
                      HorizontalAlignment="Left"
                      Margin="8,0,0,0"
                      IsHitTestVisible="False"/>

                <!-- Batch Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding SelectAllItemsCommand}"
                            Content="全部勾選"
                            Margin="0,0,6,0"/>

                    <Button Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding InvertSelectionCommand}"
                            Content="反向勾選"
                            Margin="0,0,6,0"/>

                    <Button Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding SetSelectedToSkipCommand}"
                            Content="設為跳過"/>
                </StackPanel>
            </Grid>

            <!-- Workspace: DataGrid (Left) + Inspector (Right) -->
            <Grid Grid.Row="2" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <!-- Virtualized Preview Table -->
                <Border Grid.Column="0" Style="{StaticResource StandardCardStyle}" Padding="0" Margin="0,0,16,0">
                    <DataGrid ItemsSource="{Binding FilteredItems}"
                              SelectedItem="{Binding SelectedItem}"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <!-- Selection Checkbox -->
                            <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="46">
                                <DataGridCheckBoxColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="選取" FontWeight="Bold"/>
                                    </DataTemplate>
                                </DataGridCheckBoxColumn.HeaderTemplate>
                            </DataGridCheckBoxColumn>

                            <!-- Building Name -->
                            <DataGridTextColumn Header="棟別" Binding="{Binding BuildingName}" Width="78" IsReadOnly="True"/>

                            <!-- Sheet Floor (圖紙樓層) -->
                            <DataGridTextColumn Header="圖紙樓層" Binding="{Binding SheetFloorName}" Width="75" IsReadOnly="True" FontWeight="SemiBold"/>

                            <!-- Sheet Number -->
                            <DataGridTextColumn Header="圖號" Binding="{Binding SheetNumber}" Width="110" IsReadOnly="True" FontWeight="Bold"/>

                            <!-- Sheet Name -->
                            <DataGridTextColumn Header="圖紙名稱" Binding="{Binding SheetName}" Width="170" IsReadOnly="True"/>

                            <DataGridTextColumn Header="圖框對應（依基準）" Binding="{Binding ResolvedTitleBlockName}" Width="190" IsReadOnly="True"/>

                            <!-- 一張圖紙可包含多個 Viewport / Legend / Schedule；此清單即為實際量化計畫。 -->
                            <DataGridTemplateColumn Header="量化視圖與樣板明細" Width="*" MinWidth="420" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,2">
                                            <TextBlock Text="{Binding PlannedViewsCountText}"
                                                       FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"
                                                       FontSize="{StaticResource FontSizeCaption}" Margin="0,0,0,3"/>
                                            <ItemsControl ItemsSource="{Binding PlannedViews}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{StaticResource SurfaceSubtleBrush}"
                                                                BorderBrush="{StaticResource BorderLightBrush}"
                                                                BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,0,3">
                                                            <StackPanel>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Border Background="{StaticResource PrimarySubtleBrush}" CornerRadius="3" Padding="5,1" Margin="0,0,6,0">
                                                                        <TextBlock Text="{Binding ViewType}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                                                    </Border>
                                                                    <TextBlock Text="{Binding TargetViewName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>
                                                                <WrapPanel Margin="0,3,0,0">
                                                                    <TextBlock Text="{Binding ViewDirectionDescription}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}" Margin="0,0,10,0"/>
                                                                    <TextBlock Text="樣板：" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                                                    <TextBlock Text="{Binding ViewTemplateName}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,10,0"/>
                                                                    <TextBlock Text="視埠：" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                                                    <TextBlock Text="{Binding ResolvedViewportTypeName}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,10,0"/>
                                                                    <TextBlock Text="樓層：" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                                                    <TextBlock Text="{Binding ResolvedLevelName}" FontSize="10" Foreground="{StaticResource PrimaryAccentBrush}" Margin="0,0,10,0"/>
                                                                    <TextBlock Text="範圍框：" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                                                    <TextBlock Text="{Binding ScopeBoxName}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,10,0"/>
                                                                    <TextBlock Text="位置：" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                                                    <TextBlock Text="{Binding PlacementCoord}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                </WrapPanel>
                                                                <TextBlock Text="{Binding ElevationSummary}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                                                <TextBlock Text="{Binding ViewRangeSummary, StringFormat='View Range：{0}'}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                                                                <TextBlock Text="{Binding AnnotationSummary}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Status Badge -->
                            <DataGridTemplateColumn Header="狀態" Width="100" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <controls:StatusBadge Status="{Binding Status}" CustomText="{Binding StatusMessage}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Right Inspector Panel -->
                <controls:InspectorPanel Grid.Column="1" DataContext="{Binding Inspector}"/>
            </Grid>

            <!-- Bottom Navigation -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding GoBackCommand}"
                        Content="&lt; 返回檢查"
                        MinWidth="140"/>

                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,18,0">
                    <CheckBox IsChecked="{Binding IsDeferredTaggingEnabled, Mode=TwoWay}"
                              Content="全部圖紙完成後，自動執行指定的『全部加上標籤』規則"
                              FontWeight="SemiBold"
                              Foreground="{StaticResource TextSecondaryBrush}"/>
                    <CheckBox IsChecked="{Binding IsDeferredDimensioningEnabled, Mode=TwoWay}"
                              Content="全部圖紙與標籤完成後，依 A 配置規則自動建立尺寸"
                              Margin="0,5,0,0"
                              FontWeight="SemiBold"
                              Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>

                <Button Grid.Column="2"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding GenerateCommand}"
                        Content="{Binding GenerateButtonText}"
                        MinWidth="220"
                        Padding="24,10"/>
            </Grid>
        </Grid>

        <!-- Generation Progress Overlay (Visible during execution) -->
        <controls:ProgressOverlay Progress="{Binding Progress}"
                                  CancelCommand="{Binding CancelGenerationCommand}"
                                  Visibility="{Binding IsGenerating, Converter={x:Static controls:VisibilityConverters.BoolToVisibilityConverter}}"/>
    </Grid>
</UserControl>
