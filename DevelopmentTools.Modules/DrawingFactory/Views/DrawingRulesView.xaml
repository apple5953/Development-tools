<UserControl x:Class="BIMDrawingFactory.UI.Views.DrawingRulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:models="clr-namespace:BIMDrawingFactory.UI.Models"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="950">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="圖說規則 (Drawing Rules)"
                       FontSize="{StaticResource FontSizeHeadline}"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="系統自動從現有標準圖紙 (如 SB1 系列) 逆向提取之視圖樣板、圖框定位與放置邏輯，無需人工手動輸入。"
                       FontSize="{StaticResource FontSizeBody}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,4,0,12"/>

            <!-- Auto-Detection Status Banner -->
            <Border Background="{StaticResource SurfaceSelectedBrush}"
                    BorderBrush="{StaticResource PrimaryAccentBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMedium}"
                    Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource StatusSuccessBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="自動逆向偵測" FontWeight="Bold" Foreground="White" FontSize="{StaticResource FontSizeCaption}"/>
                    </Border>
                    <TextBlock Grid.Column="1"
                               Text="已自專案現有 SB1 系列基準圖紙自動逆向提取 13 條開圖規則，包含視圖樣板、範圍框、圖框族群與視圖放置精準座標 (X, Y)。"
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Master-Detail Work Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Rules List -->
            <Border Grid.Column="0" Style="{StaticResource StandardCardStyle}" Padding="0" Margin="0,0,16,0">
                <ListBox ItemsSource="{Binding Rules}"
                         SelectedItem="{Binding SelectedRule}"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12,10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="{StaticResource PrimarySubtleBrush}" CornerRadius="3" Padding="4,1" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding SourceSheetNumber}" FontSize="{StaticResource FontSizeCaption}" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                        </Border>
                                        <TextBlock Text="{Binding RuleName}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding ViewTemplateName, StringFormat='樣板：{0}'}" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Right: Human-friendly Rule Detail Form -->
            <Border Grid.Column="1" Style="{StaticResource StandardCardStyle}" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="圖說規則與圖面放置細部特徵" FontSize="{StaticResource FontSizeSubhead}" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="{StaticResource PrimarySubtleBrush}" CornerRadius="4" Padding="8,4">
                                <TextBlock Text="{Binding SelectedRule.SourceSheetNumber, StringFormat='基準來源：{0}'}" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" FontSize="{StaticResource FontSizeCaption}"/>
                            </Border>
                        </Grid>

                        <!-- Rule Name & TitleBlock -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="圖說名稱 (Rule Name)" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding SelectedRule.RuleName, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="自動比照圖框 (TitleBlock)" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding SelectedRule.TitleBlockName, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Background="{StaticResource SurfaceSubtleBrush}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Viewport Placement Coordinates & Scope Box -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="圖面視圖放置座標 (Viewport BoxCenter)" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding SelectedRule.ViewportPlacementCoord, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Background="{StaticResource SurfaceSubtleBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="範圍框規則 (Scope Box)" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding SelectedRule.ScopeBoxRule, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Level Binding Natural Language Radio Options -->
                        <TextBlock Text="視圖樓層依附邏輯 (Level Binding)" FontWeight="SemiBold" Margin="0,4,0,8"/>
                        
                        <Border Background="{StaticResource SurfaceSubtleBrush}" CornerRadius="{StaticResource RadiusSmall}" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <RadioButton Content="● 本樓層 (Current Level) — 平面圖、柱牆圖、開口圖預設"
                                             IsChecked="True"
                                             Margin="0,0,0,6"/>
                                
                                <RadioButton Content="○ 上一層 (Previous Level) — 見下層圖使用 (例如產 5F 圖紙抓 4F 視圖)"
                                             Margin="0,0,0,6"/>

                                <RadioButton Content="○ 下一層 (Next Level) — 見上層圖使用 (例如產 5F 圖紙抓 6F 視圖)"
                                             Margin="0,0,0,6"/>

                                <RadioButton Content="○ 指定固定樓層 (Fixed Level)"
                                             Margin="0,0,0,8"/>

                                <!-- Real-time dynamic explanation box -->
                                <Border Background="{StaticResource PrimarySubtleBrush}" CornerRadius="4" Padding="10,6">
                                    <TextBlock Text="{Binding LevelExampleText}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- View Template & Scale -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="視圖樣板 (View Template)" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding SelectedRule.ViewTemplateName, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="比例 (Scale)" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding SelectedRule.Scale, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Sheet Naming Formula -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="圖紙名稱命名公式" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding SelectedRule.SheetNameFormula, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="圖號命名公式" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding SelectedRule.SheetNumberFormula, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Form Actions -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource GhostButtonStyle}"
                                    Command="{Binding TestRuleCommand}"
                                    Content="測試此規則"
                                    Margin="0,0,12,0"/>

                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding DiscardChangesCommand}"
                                    Content="捨棄變更"
                                    Margin="0,0,12,0"/>

                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding SaveRuleCommand}"
                                    Content="儲存圖說規則"
                                    MinWidth="140"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
