<Window x:Class="DevelopmentTools.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:DevelopmentTools.Core"
        Title="{Binding [TileSys_Title], Source={x:Static core:LanguageManager.Instance}}" Height="780" Width="360"
        MinHeight="560" MinWidth="340"
        Background="#1E1E2E" Foreground="#CDD6F4" FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <Window.Resources>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#89B4FA"/>
            <Setter Property="Foreground" Value="#1E1E2E"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="10,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#B4CCFB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#5e81f4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GreenBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#A6E3A1"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="SubtleBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#45475A"/>
            <Setter Property="Foreground" Value="#BAC2E0"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6C7086"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Margin" Value="2,10,0,2"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 璅? -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="??  Room Tile System"
                           FontSize="14" FontWeight="Bold"
                           Foreground="#CBA6F7"/>
                <TextBlock Text="Author: MAYOUCHR"
                           FontSize="9" FontWeight="Medium"
                           Foreground="#89B4FA"
                           Margin="2,2,0,0"/>
            </StackPanel>
            <Button Grid.Column="1"
                    Content="{Binding [TileSys_Tutorial], Source={x:Static core:LanguageManager.Instance}}"
                    Command="{Binding OpenHelpCommand}"
                    Style="{StaticResource SubtleBtn}"
                    Background="#F9E2AF"
                    Foreground="#1E1E2E"
                    Height="24"
                    Padding="6,0"
                    VerticalAlignment="Center"
                    ToolTip="{Binding [TileSys_TutorialDesc], Source={x:Static core:LanguageManager.Instance}}"/>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      Padding="0,0,4,0">
            <StackPanel>

        <!-- 鋆耨蝮恍?? -->
        <StackPanel>
            <TextBlock Text="{Binding [TileSys_AddJointParam], Source={x:Static core:LanguageManager.Instance}}"
                       Style="{StaticResource SectionLabel}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Content="{Binding [TileSys_WallJointParam], Source={x:Static core:LanguageManager.Instance}}"
                        Command="{Binding AddJointWallsCommand}"
                        Style="{StaticResource GreenBtn}"
                        ToolTip="{Binding [TileSys_Desc_WallJointParam], Source={x:Static core:LanguageManager.Instance}}"/>
                <Button Grid.Column="2"
                        Content="{Binding [TileSys_FloorJointParam2], Source={x:Static core:LanguageManager.Instance}}"
                        Command="{Binding AddJointFloorsCommand}"
                        Style="{StaticResource GreenBtn}"
                        ToolTip="{Binding [TileSys_Desc_FloorJointParam], Source={x:Static core:LanguageManager.Instance}}"/>
            </Grid>
        </StackPanel>

        <!-- 銝餉??芾票 -->
        <StackPanel>
            <TextBlock Text="{Binding [TileSys_Mode1], Source={x:Static core:LanguageManager.Instance}}"
                       Style="{StaticResource SectionLabel}"/>
            <Button Content="{Binding [TileSys_Mode1_Btn_Alt], Source={x:Static core:LanguageManager.Instance}}"
                    Command="{Binding PickFaceCommand}"
                    Style="{StaticResource PrimaryBtn}"
                    ToolTip="{Binding [TileSys_Desc_GenLayout], Source={x:Static core:LanguageManager.Instance}}"/>
            <Button Content="{Binding [TileSys_Mode1_Confirm_Alt], Source={x:Static core:LanguageManager.Instance}}"
                    Command="{Binding ConfirmMaterialPatCommand}"
                    Style="{StaticResource PrimaryBtn}"
                    Background="#A6E3A1"
                    ToolTip="{Binding [TileSys_Desc_ConfirmPaint], Source={x:Static core:LanguageManager.Instance}}"/>

            <!-- Parts workflow -->
            <TextBlock Text="磁磚放樣控制" Style="{StaticResource SectionLabel}"/>

            <TextBlock Text="牆面交接方式" Style="{StaticResource SectionLabel}" Margin="2,4,0,2"/>
            <ComboBox SelectedIndex="{Binding TileBoundaryJoinModeIndex, Mode=TwoWay}"
                      Height="28"
                      Margin="0,2,0,4"
                      ToolTip="先選擇牆面交接方式；預設會把選取牆的交接端批次設為斜角接合。">
                <ComboBoxItem Content="斜角接合"/>
                <ComboBoxItem Content="各面獨立到邊界"/>
                <ComboBoxItem Content="外角連續包角"/>
                <ComboBoxItem Content="內角留縫斷開"/>
            </ComboBox>

            <Button Content="批次牆斜角接合"
                    Command="{Binding OpenWallJoinToolCommand}"
                    Style="{StaticResource SubtleBtn}"
                    Background="#F5C2E7"
                    Foreground="#1E1E2E"
                    Height="30"
                    ToolTip="先選好多面牆，再批次處理交接端並套用 Miter 斜角接合。"/>

            <Button Content="1. 設定放樣基準"
                    Command="{Binding Step1Command}"
                    Style="{StaticResource PrimaryBtn}"
                    Background="#CBA6F7"
                    Foreground="#1E1E2E"
                    ToolTip="點選放樣基準點，供地坪與牆面磁磚對齊使用。"/>

            <Button Content="儲存/更新空間面"
                    Command="{Binding SaveLayoutFacesCommand}"
                    Style="{StaticResource SubtleBtn}"
                    Background="#F9E2AF"
                    Foreground="#1E1E2E"
                    Height="30"
                    ToolTip="依空間保存天地牆面；更新某空間不會清除其他空間紀錄。"/>

            <Button Content="2. 批次建立控制線"
                    Command="{Binding Step2Command}"
                    Style="{StaticResource PrimaryBtn}"
                    Background="#A6E3A1"
                    Foreground="#1E1E2E"
                    ToolTip="依儲存空間面與放樣基準建立磁磚控制線、邊界線與開口線。"/>

            <Button Content="3. 確認分割 Parts"
                    Command="{Binding Step3Command}"
                    Style="{StaticResource PrimaryBtn}"
                    Background="#89B4FA"
                    Foreground="#1E1E2E"
                    ToolTip="用控制線與邊界線執行 Divide Parts。"/>

            <Button Content="4. 選取/編輯分割線"
                    Command="{Binding EditSketchCommand}"
                    Style="{StaticResource PrimaryBtn}"
                    Background="#94E2D5"
                    Foreground="#1E1E2E"
                    ToolTip="選取 PartMaker 並嘗試開啟 Revit 分割草圖；若無法直接開啟，會保留選取供手動編輯。"/>

            <Button Content="刪除所選 Parts"
                    Command="{Binding ClearCalibrationCommand}"
                    Style="{StaticResource SubtleBtn}"
                    Background="#F38BA8"
                    Foreground="#1E1E2E"
                    Margin="0,4,0,4"
                    ToolTip="刪除目前選取宿主、Parts 或最近預覽所屬的分割器、Parts 與控制線。"/>

            <Button Content="目前空間磁磚表"
                    Command="{Binding CreateCurrentSpaceTileScheduleCommand}"
                    Style="{StaticResource PrimaryBtn}"
                    Background="#B4BEFE"
                    Foreground="#1E1E2E"
                    Height="32"
                    ToolTip="建立或重用目前空間的磁磚檢核表與採購表。"/>
            <Button Content="磁磚採購/檢查介面"
                    Command="{Binding OpenTilePurchaseDashboardCommand}"
                    Style="{StaticResource PrimaryBtn}"
                    Background="#F9E2AF"
                    Foreground="#1E1E2E"
                    Height="32"
                    ToolTip="用外掛視窗彙總每個空間與天地牆介面的採購片數，並檢查該空間是否已有檢核表與採購表。"/>
            <Grid Margin="0,4,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="損耗率 %"
                           VerticalAlignment="Center"
                           Foreground="#CDD6F4"
                           FontSize="11"/>
                <TextBlock Grid.Column="2"
                         Text="自動依天地牆裁切率計算"
                         Height="26"
                         Padding="6,2"
                         Foreground="#1E1E2E"
                         Background="#F5E0DC"
                         ToolTip="由外掛依 Parts 面積與採購規則自動計算浪費片數與浪費率。"/>
            </Grid>

            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="檢核整磚"
                        Command="{Binding HighlightFullTilePartsCommand}"
                        Style="{StaticResource SubtleBtn}"
                        Background="#A6E3A1"
                        Foreground="#1E1E2E"
                        Height="30"
                        ToolTip="亮顯目前空間或選取範圍內 Full 類型的磁磚 Parts。"/>
                <Button Grid.Column="2" Content="檢核半磚"
                        Command="{Binding HighlightHalfTilePartsCommand}"
                        Style="{StaticResource SubtleBtn}"
                        Background="#F9E2AF"
                        Foreground="#1E1E2E"
                        Height="30"
                        ToolTip="亮顯目前空間或選取範圍內 HalfCut 類型的磁磚 Parts。"/>
                <Button Grid.Column="4" Content="檢核不足"
                        Command="{Binding HighlightUnderHalfTilePartsCommand}"
                        Style="{StaticResource SubtleBtn}"
                        Background="#FAB387"
                        Foreground="#1E1E2E"
                        Height="30"
                        ToolTip="亮顯目前空間或選取範圍內 UnderHalfCut 類型的磁磚 Parts。"/>
            </Grid>
            <TextBlock Text="{Binding [TileSys_ExportSection], Source={x:Static core:LanguageManager.Instance}}" Style="{StaticResource SectionLabel}"/>
            <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="選取牆面粗估"
                        Command="{Binding CreateScheduleCommand}"
                        Style="{StaticResource GreenBtn}"
                        Background="#FAB387"
                        Foreground="#1E1E2E"
                        Height="32"
                        ToolTip="選取牆或牆面，依面積與材質尺寸粗估磁磚片數。"/>
                <Button Grid.Column="2" Content="{Binding [TileSys_ExportExcel], Source={x:Static core:LanguageManager.Instance}}"
                        Command="{Binding ExportExcelCommand}"
                        Style="{StaticResource GreenBtn}"
                        Background="#A6E3A1"
                        Foreground="#1E1E2E"
                        Height="32"
                        ToolTip="{Binding [TileSys_Desc_ExportExcel], Source={x:Static core:LanguageManager.Instance}}"/>
            </Grid>
        </StackPanel>

        <StackPanel>
            <TextBlock Text="{Binding [TileSys_OtherSection], Source={x:Static core:LanguageManager.Instance}}" Style="{StaticResource SectionLabel}"/>
            <Button Content="{Binding [TileSys_Desc_DeleteLayout], Source={x:Static core:LanguageManager.Instance}}"
                    Command="{Binding DeleteTilesCommand}"
                    Style="{StaticResource SubtleBtn}"
                    ToolTip="{Binding [TileSys_Desc_ResetOrigin], Source={x:Static core:LanguageManager.Instance}}"/>
            <Button Content="{Binding [TileSys_Feedback], Source={x:Static core:LanguageManager.Instance}}"
                    Click="BtnFeedback_Click"
                    Style="{StaticResource SubtleBtn}"
                    Background="#89DCEB"
                    Foreground="#1E1E2E"
                    Margin="0,4,0,0"
                    ToolTip="{Binding [TileSys_Desc_Feedback], Source={x:Static core:LanguageManager.Instance}}"/>
        </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ??? -->
        <Border Grid.Row="2" Background="#181825" CornerRadius="4"
                Margin="0,10,0,0" Padding="8,6" MinHeight="80">
            <Grid>
                <TextBlock Text="{Binding StatusText}"
                           Foreground="#A6E3A1"
                           FontSize="10"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"
                           VerticalAlignment="Top"/>
                <TextBlock Text="MACHR"
                           Foreground="#6C7086"
                           FontSize="9"
                           FontStyle="Italic"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Bottom"
                           Opacity="0.85"/>
            </Grid>
        </Border>
    </Grid>
</Window>
