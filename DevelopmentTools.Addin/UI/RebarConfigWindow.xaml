<Window x:Class="DevelopmentTools.UI.RebarConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="台灣標準鋼筋自動配置設定" Height="380" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F5F6F8">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Text="請選擇配置鋼筋規格與號數 (CNS 560)" FontSize="16" FontWeight="Bold" Foreground="#333" Margin="0,0,0,15"/>

        <!-- Form Fields -->
        <StackPanel Grid.Row="1" VerticalAlignment="Top">
            <!-- Top Rebar Size -->
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="頂部主筋規格 (拉力筋):" VerticalAlignment="Center" FontSize="12"/>
                <ComboBox x:Name="ComboTopSize" Grid.Column="1" SelectedIndex="5">
                    <ComboBoxItem Content="D10 (直徑 9.53 mm)"/>
                    <ComboBoxItem Content="D13 (直徑 12.7 mm)"/>
                    <ComboBoxItem Content="D16 (直徑 15.9 mm)"/>
                    <ComboBoxItem Content="D19 (直徑 19.1 mm)"/>
                    <ComboBoxItem Content="D22 (直徑 22.2 mm)"/>
                    <ComboBoxItem Content="D25 (直徑 25.4 mm)"/>
                    <ComboBoxItem Content="D29 (直徑 28.7 mm)"/>
                    <ComboBoxItem Content="D32 (直徑 32.2 mm)"/>
                    <ComboBoxItem Content="D36 (直徑 35.8 mm)"/>
                </ComboBox>
            </Grid>

            <!-- Bottom Rebar Size -->
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="底部主筋規格 (底筋):" VerticalAlignment="Center" FontSize="12"/>
                <ComboBox x:Name="ComboBottomSize" Grid.Column="1" SelectedIndex="5">
                    <ComboBoxItem Content="D10 (直徑 9.53 mm)"/>
                    <ComboBoxItem Content="D13 (直徑 12.7 mm)"/>
                    <ComboBoxItem Content="D16 (直徑 15.9 mm)"/>
                    <ComboBoxItem Content="D19 (直徑 19.1 mm)"/>
                    <ComboBoxItem Content="D22 (直徑 22.2 mm)"/>
                    <ComboBoxItem Content="D25 (直徑 25.4 mm)"/>
                    <ComboBoxItem Content="D29 (直徑 28.7 mm)"/>
                    <ComboBoxItem Content="D32 (直徑 32.2 mm)"/>
                    <ComboBoxItem Content="D36 (直徑 35.8 mm)"/>
                </ComboBox>
            </Grid>

            <!-- Stirrup Size -->
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="箍筋/繫筋規格:" VerticalAlignment="Center" FontSize="12"/>
                <ComboBox x:Name="ComboStirrupSize" Grid.Column="1" SelectedIndex="1">
                    <ComboBoxItem Content="D10 (直徑 9.53 mm)"/>
                    <ComboBoxItem Content="D13 (直徑 12.7 mm)"/>
                    <ComboBoxItem Content="D16 (直徑 15.9 mm)"/>
                    <ComboBoxItem Content="D19 (直徑 19.1 mm)"/>
                </ComboBox>
            </Grid>

            <!-- Stirrup Spacing -->
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="箍筋配置間距 (mm):" VerticalAlignment="Center" FontSize="12"/>
                <TextBox x:Name="TxtStirrupSpacing" Grid.Column="1" Text="150" Padding="3" VerticalContentAlignment="Center"/>
            </Grid>

            <!-- Concrete Cover -->
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="混凝土保護層 (mm):" VerticalAlignment="Center" FontSize="12"/>
                <TextBox x:Name="TxtCover" Grid.Column="1" Text="40" Padding="3" VerticalContentAlignment="Center"/>
            </Grid>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="確定配置" Width="90" Height="28" Background="#1D63FF" Foreground="White" BorderThickness="0" Margin="0,0,10,0" Click="BtnConfirm_Click"/>
            <Button Content="取消" Width="70" Height="28" Background="#DDD" BorderThickness="0" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
