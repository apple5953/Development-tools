<Window x:Class="DevelopmentTools.UI.RebarConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="可調式鋼筋配置預覽" Height="720" Width="1120"
        MinHeight="650" MinWidth="980"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#15161A" Foreground="#F4F7FB">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBg" Color="#202128"/>
        <SolidColorBrush x:Key="FieldBg" Color="#101116"/>
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#3A3D48"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#00B8D9"/>
        <SolidColorBrush x:Key="WarnBrush" Color="#FFCC66"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F4F7FB"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#64D2FF"/>
            <Setter Property="Margin" Value="0,12,0,8"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#B7BDC9"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#F4F7FB"/>
            <Setter Property="Background" Value="{StaticResource FieldBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Foreground" Value="#111318"/>
            <Setter Property="Background" Value="#F3F5F7"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#111318"/>
            <Setter Property="Background" Value="#FFFFFF"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#0086D1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Foreground" Value="#F4F7FB"/>
            <Setter Property="Background" Value="#363944"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="可調式鋼筋配置預覽" FontSize="22" FontWeight="Bold"/>
                <TextBlock x:Name="TxtElementSummary" Foreground="#A8B0C2" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="新手說明" Background="#FFCC66" Foreground="#1B1B1B"
                    BorderThickness="0" FontWeight="Bold" Padding="14,0" Height="32"
                    Click="BtnHelp_Click"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="390"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="1. 主筋配置" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="頂筋 / 柱主筋號數" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="ComboTopSize" SelectedIndex="5" SelectionChanged="InputChanged">
                                    <ComboBoxItem Tag="9.53" Content="D10 (9.53 mm)"/>
                                    <ComboBoxItem Tag="12.7" Content="D13 (12.7 mm)"/>
                                    <ComboBoxItem Tag="15.9" Content="D16 (15.9 mm)"/>
                                    <ComboBoxItem Tag="19.1" Content="D19 (19.1 mm)"/>
                                    <ComboBoxItem Tag="22.2" Content="D22 (22.2 mm)"/>
                                    <ComboBoxItem Tag="25.4" Content="D25 (25.4 mm)"/>
                                    <ComboBoxItem Tag="28.7" Content="D29 (28.7 mm)"/>
                                    <ComboBoxItem Tag="32.2" Content="D32 (32.2 mm)"/>
                                    <ComboBoxItem Tag="35.8" Content="D36 (35.8 mm)"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="底筋號數" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="ComboBottomSize" SelectedIndex="5" SelectionChanged="InputChanged">
                                    <ComboBoxItem Tag="9.53" Content="D10 (9.53 mm)"/>
                                    <ComboBoxItem Tag="12.7" Content="D13 (12.7 mm)"/>
                                    <ComboBoxItem Tag="15.9" Content="D16 (15.9 mm)"/>
                                    <ComboBoxItem Tag="19.1" Content="D19 (19.1 mm)"/>
                                    <ComboBoxItem Tag="22.2" Content="D22 (22.2 mm)"/>
                                    <ComboBoxItem Tag="25.4" Content="D25 (25.4 mm)"/>
                                    <ComboBoxItem Tag="28.7" Content="D29 (28.7 mm)"/>
                                    <ComboBoxItem Tag="32.2" Content="D32 (32.2 mm)"/>
                                    <ComboBoxItem Tag="35.8" Content="D36 (35.8 mm)"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="LblTopCount" Text="頂筋支數" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtTopCount" Text="2" TextChanged="InputChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock x:Name="LblBottomCount" Text="底筋支數" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtBottomCount" Text="2" TextChanged="InputChanged"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="側筋 / 腰筋支數" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtSideCount" Text="0" TextChanged="InputChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="保護層 mm" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtCover" Text="40" TextChanged="InputChanged"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="2. 箍筋 / 繫筋" Style="{StaticResource SectionTitle}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="箍筋號數" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="ComboStirrupSize" SelectedIndex="1" SelectionChanged="InputChanged">
                                    <ComboBoxItem Tag="9.53" Content="D10 (9.53 mm)"/>
                                    <ComboBoxItem Tag="12.7" Content="D13 (12.7 mm)"/>
                                    <ComboBoxItem Tag="15.9" Content="D16 (15.9 mm)"/>
                                    <ComboBoxItem Tag="19.1" Content="D19 (19.1 mm)"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="箍筋型式" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="ComboStirrupStyle" SelectedIndex="0" SelectionChanged="InputChanged">
                                    <ComboBoxItem Content="封閉箍"/>
                                    <ComboBoxItem Content="U 型箍 (預覽)"/>
                                    <ComboBoxItem Content="雙肢箍 (預覽)"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="一般區間距 mm" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtNormalSpacing" Text="150" TextChanged="InputChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="端部加密間距 mm" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtDenseSpacing" Text="100" TextChanged="InputChanged"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="LblDenseLength" Text="端部加密長度 mm" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtDenseLength" Text="600" TextChanged="InputChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="首支箍筋離端部 mm" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtStartOffset" Text="50" TextChanged="InputChanged"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="3. 接頭與避讓" Style="{StaticResource SectionTitle}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="主筋接頭形式" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="ComboConnectionMode" SelectedIndex="0" SelectionChanged="InputChanged">
                                    <ComboBoxItem Content="連續鋼筋"/>
                                    <ComboBoxItem Content="搭接分段"/>
                                    <ComboBoxItem Content="續接器分段"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="端部形式" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="ComboEndMode" SelectedIndex="0" SelectionChanged="InputChanged">
                                    <ComboBoxItem Content="直筋"/>
                                    <ComboBoxItem Content="90 度彎鉤 (預覽)"/>
                                    <ComboBoxItem Content="135 度彎鉤 (預覽)"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="最大單支長度 mm" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtMaxSegmentLength" Text="12000" TextChanged="InputChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="搭接長度 mm" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtLapLength" Text="1000" TextChanged="InputChanged"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="續接器避讓間隙 mm" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtCouplerGap" Text="80" TextChanged="InputChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="端部錨定外伸 mm" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtAnchorage" Text="300" TextChanged="InputChanged"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="提醒：目前續接器會先用分段與避讓間隙表示；若要放置真實續接器族，後續可接公司族庫與接頭規則。"
                                   Foreground="#A8B0C2" FontSize="11" Margin="0,12,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="3D 預覽" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="藍色為主筋，青色為箍筋，黃色為接頭位置；灰色透明體為樑柱外框。" Foreground="#A8B0C2" FontSize="11"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="重設建議值" Style="{StaticResource GhostButton}" Click="BtnReset_Click"/>
                    </Grid>

                    <Border Grid.Row="1" Background="#0F1015" BorderBrush="#333744" BorderThickness="1">
                        <Viewport3D x:Name="PreviewViewport" ClipToBounds="True"/>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtPreviewStatus" Foreground="#A8B0C2" FontSize="12" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Background="#12141B" BorderBrush="#333744" BorderThickness="1" Padding="10">
                            <TextBlock x:Name="TxtWarning" Foreground="{StaticResource WarnBrush}" FontSize="12"/>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TxtFooter" Foreground="#A8B0C2" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="取消" Style="{StaticResource GhostButton}" Width="96" Click="BtnCancel_Click"/>
            <Button Grid.Column="3" Content="建立鋼筋" Style="{StaticResource PrimaryButton}" Width="128" Click="BtnConfirm_Click"/>
        </Grid>
    </Grid>
</Window>
