<UserControl x:Class="DevelopmentTools.Modules.AdaptiveSectionBox.Views.RegionManagerDockablePane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="300"
             Background="#07090E">

    <UserControl.Resources>
        <!-- 配色系統 -->
        <SolidColorBrush x:Key="PanelBg" Color="#0D1117"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#30363D"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#C9D1D9"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#8B949E"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#1F6FEB"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#238636"/>
        <SolidColorBrush x:Key="AccentRed" Color="#DA3633"/>
        <SolidColorBrush x:Key="HoverBg" Color="#21262D"/>

        <!-- 按鈕基本樣式 -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#21262D"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Microsoft JhengHei"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#30363D"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 藍色強調按鈕 -->
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{StaticResource AccentBlue}"/>
            <Setter Property="BorderBrush" Value="#388BFD"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#58A6FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 綠色啟動按鈕 -->
        <Style x:Key="GreenButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{StaticResource AccentGreen}"/>
            <Setter Property="BorderBrush" Value="#3FB950"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#49E35F"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 紅色危險按鈕 -->
        <Style x:Key="RedButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{StaticResource AccentRed}"/>
            <Setter Property="BorderBrush" Value="#F85149"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF7B72"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ListBoxItem 樣式 -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#21262D"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1F6FEB"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#161B22"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <!-- 標題 -->
            <RowDefinition Height="Auto"/>
            <!-- 快速新建 -->
            <RowDefinition Height="Auto"/>
            <!-- 區域清單 -->
            <RowDefinition Height="180"/>
            <!-- 詳細設定 / 3D 互動控制 -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. 標題 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="DT Adaptive Region" FontSize="18" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="智慧空間多邊形剖面盒系統" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- 2. 快速新建 -->
        <Border Grid.Row="1" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="⚡ 快速新建剖面盒" FontSize="12" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8"/>
                <UniformGrid Columns="3">
                    <Button Content="⏹️ 矩形" Style="{StaticResource ModernButton}" Command="{Binding CreateCommand}" Margin="2"/>
                    <Button Content="📐 L形" Style="{StaticResource ModernButton}" Command="{Binding CreateLShapeCommand}" Margin="2"/>
                    <Button Content="凵 U形" Style="{StaticResource ModernButton}" Command="{Binding CreateUShapeCommand}" Margin="2"/>
                </UniformGrid>
            </StackPanel>
        </Border>

        <!-- 3. 區域清單 -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="📋 空間區域清單" FontSize="12" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,6"/>
            <ListBox Grid.Row="1" ItemsSource="{Binding Regions}" SelectedItem="{Binding SelectedRegion}" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" DisplayMemberPath="Name" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
        </Grid>

        <!-- 4. 詳細設定 / 3D 互動控制 -->
        <Grid Grid.Row="3">
            <!-- 未選中區域提示 -->
            <TextBlock Text="💡 請先於清單中選擇一個空間區域，以開啟 3D 互動編輯與高度設定。" 
                       Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" 
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                       Visibility="{Binding GuideVisibility}"/>

            <!-- 已選中區域詳細配置面板 -->
            <Grid Visibility="{Binding DetailsVisibility}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 編輯名稱與刪除 -->
                <Border Grid.Row="0" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding EditingName, UpdateSourceTrigger=PropertyChanged}" Background="#161B22" Foreground="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="6,4" VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1" Content="重新命名" Style="{StaticResource ModernButton}" Command="{Binding RenameCommand}" Margin="6,0,0,0" Padding="8,4"/>
                        <Button Grid.Column="2" Content="❌" Style="{StaticResource RedButton}" Command="{Binding DeleteCommand}" Margin="6,0,0,0" Padding="8,4" ToolTip="刪除此區域"/>
                    </Grid>
                </Border>

                <!-- 3D 滑鼠拖曳互動按鈕 -->
                <Border Grid.Row="1" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="🖱️ 3D 視景滑鼠互動" FontSize="12" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8"/>
                        <!-- 關閉編輯狀態下的啟動按鈕 -->
                        <Button Content="🚀 啟動 3D 滑鼠拖曳編輯" Style="{StaticResource GreenButton}" Command="{Binding StartEditCommand}" Visibility="{Binding NormalModeVisibility}" Padding="10,8"/>
                        <!-- 啟動編輯狀態下的關閉按鈕 -->
                        <Button Content="⏹️ 結束 3D 互動編輯" Style="{StaticResource AccentButton}" Command="{Binding StopEditCommand}" Visibility="{Binding EditModeVisibility}" Padding="10,8"/>
                        <TextBlock Text="※ 啟動編輯後，您可直接在 3D 視圖中用滑鼠點擊亮黃色控制球，往任意方向平移或拉伸高度！" FontSize="11" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,0" TextAlignment="Justify"/>
                    </StackPanel>
                </Border>

                <!-- 空間高度微調 -->
                <Border Grid.Row="2" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="📐 空間高度微調 (ft)" FontSize="12" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8"/>

                        <!-- 底部高度 ZMin -->
                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="底部 (ZMin): " Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ZMin, StringFormat={}{0:F2}}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="▲ +0.5" Style="{StaticResource ModernButton}" Command="{Binding AdjustHeightCommand}" CommandParameter="ZMin:0.5" Padding="6,4" Margin="4,0,0,0"/>
                            <Button Grid.Column="2" Content="▼ -0.5" Style="{StaticResource ModernButton}" Command="{Binding AdjustHeightCommand}" CommandParameter="ZMin:-0.5" Padding="6,4" Margin="4,0,0,0"/>
                        </Grid>

                        <!-- 頂部高度 ZMax -->
                        <Grid Grid.Row="2" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="頂部 (ZMax): " Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ZMax, StringFormat={}{0:F2}}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="▲ +0.5" Style="{StaticResource ModernButton}" Command="{Binding AdjustHeightCommand}" CommandParameter="ZMax:0.5" Padding="6,4" Margin="4,0,0,0"/>
                            <Button Grid.Column="2" Content="▼ -0.5" Style="{StaticResource ModernButton}" Command="{Binding AdjustHeightCommand}" CommandParameter="ZMax:-0.5" Padding="6,4" Margin="4,0,0,0"/>
                        </Grid>

                        <!-- 控制點列表 -->
                        <Grid Grid.Row="3" Margin="0,6,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="📍 平面控制點列表" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                            <ListBox Grid.Row="1" ItemsSource="{Binding BasePointsList}" Background="#161B22" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" FontSize="11"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
