<Window x:Class="DevelopmentTools.Modules.SheetTools.QuickDimension.RecordAnnotationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DevelopmentTools.Modules.SheetTools.QuickDimension"
        Title="視圖自動標註邏輯分析與設定" Height="700" Width="1050"
        Background="#0F1117" Foreground="#E6EDF3" FontFamily="Microsoft JhengHei UI"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True" 
        Topmost="True" ResizeMode="CanResize">

    <Window.Resources>
        <local:DetectedModeColorConverter x:Key="DetectedModeColorConverter"/>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        
        <SolidColorBrush x:Key="BgPrimary" Color="#0F1117"/>
        <SolidColorBrush x:Key="BgPanel" Color="#161B22"/>
        <SolidColorBrush x:Key="BgCard" Color="#1C2128"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#388BFD"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#E6EDF3"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#7D8590"/>
        <SolidColorBrush x:Key="BorderColor" Color="#30363D"/>

        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="#F25C54"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Body -->
            <RowDefinition Height="*"/>
            <!-- Footer Buttons -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <Border Grid.Row="0" Background="{StaticResource BgPanel}" CornerRadius="6" Padding="12" Margin="0,0,0,16" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="🎯 專案圖紙與視圖標註分析工具" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="本工具會自動分析專案內各張圖紙上視圖的既有尺寸標註方法，支援多種標註邏輯同時併存，以便在專案轉移時直接於目標圖紙上自動重建標註。" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Click="OnAutoDetectAll" Content="⚡ 自動偵測所有視圖既有標註" Style="{StaticResource BtnPrimary}" VerticalAlignment="Center" Padding="12,6"/>
            </Grid>
        </Border>

        <!-- 2. Body -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="1.3*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Sheets and Views Tree -->
            <Border Grid.Column="0" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="📖 圖紙與視圖清單" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" Foreground="{StaticResource TextPrimary}"/>
                    
                    <TreeView Grid.Row="1" ItemsSource="{Binding Sheets}" Background="Transparent" BorderThickness="0" SelectedItemChanged="OnTreeViewSelectedItemChanged">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="True"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Views}">
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <TextBlock Text="📋 "/>
                                    <TextBlock Text="{Binding SheetNumber, StringFormat='[{0}] '}" Foreground="{StaticResource TextSecondary}"/>
                                    <TextBlock Text="{Binding SheetName}" FontWeight="SemiBold"/>
                                </StackPanel>
                                <HierarchicalDataTemplate.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextPrimary}"/>
                                            <TextBlock Text="👁️ " VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding ViewName}" VerticalAlignment="Center" FontWeight="Medium"/>
                                            <TextBlock Text="{Binding DetectedLogicText, StringFormat=' ({0})'}" Foreground="{Binding DetectedMode, Converter={x:Static local:DetectedModeColorConverter.Instance}}" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="10"/>
                                            <TextBlock Text=" [已記錄]" Foreground="#A6E3A1" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="10" Visibility="{Binding HasConfig, Converter={x:Static local:BoolToVisibilityConverter.Instance}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </HierarchicalDataTemplate.ItemTemplate>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- Right: Config Editor -->
            <Border Grid.Column="2" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="⚙️ 標註邏輯與參數設定" FontWeight="Bold" FontSize="14" Margin="0,0,0,16" Foreground="{StaticResource TextPrimary}"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Name="ConfigPanel" IsEnabled="False">
                            <TextBlock Text="💡 勾選啟用標註邏輯後，即可展開設定對應的尺寸標註型式與偏移值。支援多個邏輯併存。" Foreground="#E3B341" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,12"/>
                            
                            <TextBlock Text="{Binding SelectedViewItem.ViewName, StringFormat='選取視圖: {0}'}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" Margin="0,0,0,12"/>

                            <!-- View Template Info -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <TextBlock Text="儲存之目標視圖樣板: " Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock Text="{Binding ViewTemplateName}" Foreground="#FAB387" FontWeight="Bold"/>
                            </StackPanel>

                            <!-- Logics Cards ItemsControl -->
                            <ItemsControl ItemsSource="{Binding SelectedViewItem.Logics}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                                            <StackPanel>
                                                <!-- Header: Checkbox to enable -->
                                                <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="12" Margin="0,0,0,6">
                                                    <TextBlock Text="{Binding Name}"/>
                                                </CheckBox>

                                                <!-- Configuration Fields (Visible only if Enabled) -->
                                                <StackPanel Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVisibilityConverter}}" Margin="16,6,0,0">
                                                    <!-- Style Dropdown -->
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="80"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="標註型式:" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" FontSize="11"/>
                                                        <ComboBox Grid.Column="1" ItemsSource="{Binding DataContext.DimensionTypes, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                  SelectedItem="{Binding SelectedDimensionType}" DisplayMemberPath="Name" Height="26" VerticalContentAlignment="Center" FontSize="11"/>
                                                    </Grid>

                                                    <!-- Offset Slider -->
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="80"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="60"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="偏移距離:" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" FontSize="11"/>
                                                        <Slider Grid.Column="1" Minimum="0" Maximum="3000" TickFrequency="100" IsSnapToTickEnabled="True" Value="{Binding OffsetDistance, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding OffsetDistance, StringFormat='{}{0} mm'}" Foreground="#FAB387" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"/>
                                                    </Grid>

                                                    <!-- Prefix & Suffix -->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="80"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="20"/>
                                                            <ColumnDefinition Width="80"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="文字前綴:" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" FontSize="11"/>
                                                        <TextBox Grid.Column="1" Text="{Binding PrefixText, UpdateSourceTrigger=PropertyChanged}" Background="#0F1117" Foreground="White" BorderBrush="{StaticResource BorderColor}" Height="24" VerticalContentAlignment="Center" FontSize="11"/>
                                                        
                                                        <TextBlock Grid.Column="3" Text="文字後綴:" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" FontSize="11"/>
                                                        <TextBox Grid.Column="4" Text="{Binding SuffixText, UpdateSourceTrigger=PropertyChanged}" Background="#0F1117" Foreground="White" BorderBrush="{StaticResource BorderColor}" Height="24" VerticalContentAlignment="Center" FontSize="11"/>
                                                    </Grid>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. Footer Buttons -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="💡 提示：勾選需要記錄的視圖後，點選「儲存所有勾選的視圖邏輯」進行批次儲存。" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" FontSize="11"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Click="OnDeleteSelected" Content="清除選取設定" Style="{StaticResource BtnDanger}" Margin="0,0,10,0" Padding="16,8"/>
                <Button Click="OnSaveAllSelected" Content="💾 儲存所有勾選的視圖邏輯" Style="{StaticResource BtnPrimary}" Padding="20,8"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
