<Window x:Class="DevelopmentTools.Modules.SheetTools.AutoBoundary.AutoBoundaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:DevelopmentTools.Core"
        Title="{Binding [AutoBoundary_Title], Source={x:Static core:LanguageManager.Instance}}"
        Height="340" Width="500"
        WindowStartupLocation="CenterOwner"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent">

    <Window.Resources>
        <!-- Modern Fonts -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Microsoft JhengHei, Segoe UI"/>
            <Setter Property="Foreground" Value="#F5F5F7"/>
        </Style>

        <!-- Radio Button Styling -->
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#F5F5F7"/>
            <Setter Property="FontFamily" Value="Microsoft JhengHei, Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,20,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Premium Button Styling -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#007ACC" Offset="0.0"/>
                        <GradientStop Color="#00A3FF" Offset="1.0"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Microsoft JhengHei, Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#008AE6" Offset="0.0"/>
                                <GradientStop Color="#33B5FF" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8E8E93"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="6,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF453A"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HelpButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFCC66"/>
            <Setter Property="Foreground" Value="#111318"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Microsoft JhengHei, Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFD980"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border CornerRadius="10" Background="#111318" BorderThickness="1" BorderBrush="#343946">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,0,0,15">
                    <TextBlock Text="{Binding [AutoBoundary_Eyebrow], Source={x:Static core:LanguageManager.Instance}}" FontSize="10" FontWeight="Bold" Foreground="#64D2FF"/>
                    <TextBlock Text="{Binding [AutoBoundary_Subtitle], Source={x:Static core:LanguageManager.Instance}}" FontSize="18" FontWeight="Bold" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="{Binding [TileSys_Tutorial], Source={x:Static core:LanguageManager.Instance}}"
                        ToolTip="{Binding [TileSys_TutorialDesc], Source={x:Static core:LanguageManager.Instance}}"
                        Style="{StaticResource HelpButtonStyle}"
                        Click="HelpButton_Click"
                        VerticalAlignment="Top"
                        Margin="0,0,8,0"/>
                <Button Grid.Column="2" Content="✕" Style="{StaticResource CloseButtonStyle}" Click="CloseButton_Click" VerticalAlignment="Top"/>
            </Grid>

            <!-- Main Body -->
            <Border Grid.Row="1" Background="#1B1F27" CornerRadius="8" Padding="15" BorderThickness="1" BorderBrush="#343946">
                <StackPanel Grid.Row="1" Orientation="Vertical">
                    <!-- Operation Mode -->
                    <TextBlock Text="{Binding [AutoBoundary_ModeTitle], Source={x:Static core:LanguageManager.Instance}}" FontSize="13" FontWeight="Bold" Foreground="#B7BDC9" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <RadioButton Name="RadioRoom" Content="{Binding [AutoBoundary_RoomMode], Source={x:Static core:LanguageManager.Instance}}" IsChecked="True"/>
                        <RadioButton Name="RadioSpace" Content="{Binding [AutoBoundary_SpaceMode], Source={x:Static core:LanguageManager.Instance}}"/>
                        <RadioButton Name="RadioArea" Content="{Binding [AutoBoundary_AreaMode], Source={x:Static core:LanguageManager.Instance}}"/>
                    </StackPanel>

                    <TextBlock Text="{Binding [AutoBoundary_Hint1], Source={x:Static core:LanguageManager.Instance}}" FontSize="11" Foreground="#FFCC66" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    <TextBlock Text="{Binding [AutoBoundary_Hint2], Source={x:Static core:LanguageManager.Instance}}" FontSize="11" Foreground="#FFCC66" TextWrapping="Wrap" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- Footer / Action -->
            <Grid Grid.Row="2" Margin="0,15,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="TextStatus" Grid.Column="0" Text="{Binding [AutoBoundary_StatusReady], Source={x:Static core:LanguageManager.Instance}}" VerticalAlignment="Center" Foreground="#B7BDC9" FontSize="12"/>
                <Button Grid.Column="1" Content="{Binding [AutoBoundary_Optimize], Source={x:Static core:LanguageManager.Instance}}" Click="OptimizeButton_Click" Margin="0,0,10,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#252A33"/>
                            <Setter Property="Foreground" Value="#F5F5F7"/>
                            <Setter Property="BorderBrush" Value="#3A4150"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="FontFamily" Value="Microsoft JhengHei, Segoe UI"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="15,8"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6" 
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#343B49"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Grid.Column="2" Content="{Binding [AutoBoundary_Start], Source={x:Static core:LanguageManager.Instance}}" Style="{StaticResource ActionButtonStyle}" Click="StartButton_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
