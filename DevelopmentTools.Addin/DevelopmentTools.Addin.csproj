<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>DevelopmentTools.Addin</AssemblyName>
    <RootNamespace>DevelopmentTools</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- 引用 Revit 2024 API -->
    <Reference Include="RevitAPI">
      <HintPath>C:\Program Files\Autodesk\Revit 2024\RevitAPI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>C:\Program Files\Autodesk\Revit 2024\RevitAPIUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="AdWindows">
      <HintPath>C:\Program Files\Autodesk\Revit 2024\AdWindows.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System.Net.Http">
      <HintPath>C:\Program Files (x86)\Reference Assemblies\Microsoft\Framework\System.Net.Http\v4.0\System.Net.Http.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Microsoft.Office.Interop.Word">
      <HintPath>lib\Microsoft.Office.Interop.Word.dll</HintPath>
      <EmbedInteropTypes>True</EmbedInteropTypes>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BEAI\RealityBridge\BEAI.QueryHost\BEAI.QueryHost.csproj" />
    <!-- 內建功能模組 -->
    <ProjectReference Include="..\DevelopmentTools.Modules\*\*.csproj" />
    <!-- Worker 由獨立 MSBuild target 建置，不成為 Revit Addin 的組件參考。 -->
    <AgentWorkerProject Include="..\DevelopmentTools.AgentWorkers\*\*.csproj" />
  </ItemGroup>

  <Target Name="ValidateModuleManifests" BeforeTargets="ResolveProjectReferences">
    <Exec Command="python &quot;$(MSBuildProjectDirectory)\..\module-platform\validate.py&quot;" />
  </Target>
  <Target Name="GenerateModuleRegistration" BeforeTargets="CoreCompile" DependsOnTargets="ValidateModuleManifests">
    <Exec Command="python &quot;$(MSBuildProjectDirectory)\..\module-platform\generate.py&quot;" />
  </Target>

  <Target Name="BuildAgentWorkers" BeforeTargets="StageApprovedAgentWorkers">
    <MSBuild Projects="@(AgentWorkerProject)" Targets="Build" Properties="Configuration=$(Configuration)" BuildInParallel="true" />
  </Target>
  <Target Name="CleanAgentWorkers" BeforeTargets="Clean">
    <MSBuild Projects="@(AgentWorkerProject)" Targets="Clean" Properties="Configuration=$(Configuration)" BuildInParallel="true" />
  </Target>
  <Target Name="StageApprovedAgentWorkers" AfterTargets="Build" DependsOnTargets="BuildAgentWorkers">
    <Exec Command="python &quot;$(MSBuildProjectDirectory)\..\module-platform\prepare_agents.py&quot; --configuration &quot;$(Configuration)&quot; --output &quot;$(TargetDir)Agents&quot;" />
  </Target>


  <ItemGroup>
    <!-- 引用 System.Text.Json 用於 JSON 序列化 -->
    <PackageReference Include="System.Text.Json" Version="8.0.3" />
    <PackageReference Include="Obfuscar" Version="2.2.38" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Update="platform_config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="version.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Config\feature-flags.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\RibbonIcons\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\Templates\*.xlsx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Rules\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Rules\CodeCheck\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Bridge\Worker\BEAI.QueryWorker.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Runtime\Worker\v0001\BEAI.QueryWorker.exe</TargetPath>
    </None>
    <None Update="Bridge\Worker\Newtonsoft.Json.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Runtime\Worker\v0001\Newtonsoft.Json.dll</TargetPath>
    </None>
    <None Update="Bridge\Rules\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Runtime\Rules\%(Filename)%(Extension)</TargetPath>
    </None>
  </ItemGroup>

  <Target Name="Obfuscate" AfterTargets="AfterBuild" DependsOnTargets="StageApprovedAgentWorkers" Condition="'$(Configuration)' == 'Release'">
    <Message Text="[Obfuscar] Starting obfuscation..." Importance="High" />
    <Exec Command="python &quot;$(MSBuildProjectDirectory)\..\module-platform\prepare_release.py&quot;" />
    <Exec Command="&quot;$(Obfuscar)&quot; &quot;$(MSBuildProjectDirectory)\obj\Release\module-platform\obfuscar.generated.xml&quot;" />
    <Message Text="[Obfuscar] Obfuscation finished." Importance="High" />
  </Target>
</Project>
